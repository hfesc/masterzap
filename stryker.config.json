{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "testRunnerNodeArgs": ["--no-warnings"],
  "mutate": [
    "src/lib/utils.js",
    "src/lib/search.js",
    "src/lib/read-state.js",
    "src/lib/export.js",
    "src/lib/data-store.js",
    "src/lib/avatar.js",
    "src/lib/media.js",
    "src/lib/router.js"
  ],
  "ignorePatterns": [
    "dist/**",
    "public/export/**",
    "ref/**",
    ".tools/**"
  ],
  "disableTypeChecks": false,
  "ignoreStatic": true,
  "reporters": [
    "progress",
    "clear-text",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/stryker.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 65,
    "break": 60
  },
  "incremental": true,
  "incrementalFile": "reports/mutation/stryker-incremental.json",
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "timeoutMS": 10000
}
